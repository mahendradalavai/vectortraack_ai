# VectorTrack AI — environment variables
#
# Copy to .env for local development (`.env` is gitignored) or provide the
# same names through your deployment platform's secret manager.
# Never commit real keys.

# ── Supabase project ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Safe for the browser: it is served to the dashboard
# through GET /config and is constrained by Row Level Security.
SUPABASE_ANON_KEY=your-public-anon-key

# Service-role key. SERVER ONLY — bypasses Row Level Security.
# It must never appear in static/ or any frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# ── Storage buckets ───────────────────────────────────────────────────────────
SUPABASE_ORIGINALS_BUCKET=vectortrack-originals
SUPABASE_RESULTS_BUCKET=vectortrack-results

# ── Optional ──────────────────────────────────────────────────────────────────
# Lifetime of the signed media URLs handed to the dashboard (seconds).
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=3600

# Only needed for older projects whose access tokens are still signed with the
# legacy shared JWT secret instead of asymmetric JWKS keys.
# SUPABASE_JWT_SECRET=

# Lets the standalone CLI scripts (detect.py / test_image.py) persist
# detections for one known Supabase user id. It also overrides the shared
# app account used by signed-out detections.
# SUPABASE_DEV_USER_ID=

# E-mail of the shared app account that signed-out (no Google login) detections
# belong to. It is looked up and, if missing, created once with the
# service-role key. Defaults to vectortrack-app@vectortrack.local
# SUPABASE_APP_EMAIL=

# Comma separated list of allowed browser origins. Defaults to *.
# CORS_ALLOW_ORIGINS=http://localhost:8000,https://your-app.example.com
